# =============================================================================
# Tempize Backend — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs
#   cp .env.example .env
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── PostgreSQL + PostGIS ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tempize
POSTGRES_PASSWORD=tempize_secret
POSTGRES_DB=tempize_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT / Authentification ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRATION=30d

# ── OAuth (Google) ───────────────────────────────────────────────────────────
# IDs client Google autorisés, séparés par des virgules (Web, Android, iOS).
GOOGLE_CLIENT_IDS=
# Compatibilité : utilisé si GOOGLE_CLIENT_IDS n’est pas défini.
GOOGLE_CLIENT_ID=

# ── Stockage Media (S3-compatible) ──────────────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=tempize-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── Push Notifications ──────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
